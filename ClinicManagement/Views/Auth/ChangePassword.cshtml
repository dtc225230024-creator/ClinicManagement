@model ClinicManagement.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Tài khoản</p>
        <h1>Đổi mật khẩu</h1>
        <p>Cập nhật mật khẩu để bảo vệ dữ liệu phòng khám.</p>
        @if (Model.IsRequiredBySystem)
        {
            <p class="text-danger mb-0">Bạn đang đăng nhập bằng mật khẩu tạm thời. Vui lòng đổi mật khẩu trước khi tiếp tục.</p>
        }
    </div>
</section>

<form asp-action="ChangePassword" method="post" class="form-grid">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-label">
        <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
        <div class="password-field">
            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" data-password-toggle-target="true" />
            <button class="password-toggle" type="button" data-password-toggle="true" aria-label="Hiện mật khẩu" aria-pressed="false">
                <svg class="password-toggle-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                    <path d="M12 5c5 0 8.7 4.1 10 7-1.3 2.9-5 7-10 7s-8.7-4.1-10-7c1.3-2.9 5-7 10-7Zm0 2C8.8 7 6 9.1 4.3 12 6 14.9 8.8 17 12 17s6-2.1 7.7-5C18 9.1 15.2 7 12 7Zm0 2.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z" />
                </svg>
            </button>
        </div>
        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
    </div>
    <br />
    <div class="form-label">
        <label asp-for="NewPassword">Mật khẩu mới</label>
        <div class="password-field">
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" data-password-toggle-target="true" />
            <button class="password-toggle" type="button" data-password-toggle="true" aria-label="Hiện mật khẩu" aria-pressed="false">
                <svg class="password-toggle-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                    <path d="M12 5c5 0 8.7 4.1 10 7-1.3 2.9-5 7-10 7s-8.7-4.1-10-7c1.3-2.9 5-7 10-7Zm0 2C8.8 7 6 9.1 4.3 12 6 14.9 8.8 17 12 17s6-2.1 7.7-5C18 9.1 15.2 7 12 7Zm0 2.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z" />
                </svg>
            </button>
        </div>
        <small class="form-hint">Tối thiểu 10 ký tự, có chữ hoa, chữ thường, chữ số, ký tự đặc biệt @@$!%*?&, không chứa khoảng trắng, không quá phổ biến và phải khác mật khẩu hiện tại.</small>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <div class="form-label">
        <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
        <div class="password-field">
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" data-password-toggle-target="true" />
            <button class="password-toggle" type="button" data-password-toggle="true" aria-label="Hiện mật khẩu" aria-pressed="false">
                <svg class="password-toggle-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                    <path d="M12 5c5 0 8.7 4.1 10 7-1.3 2.9-5 7-10 7s-8.7-4.1-10-7c1.3-2.9 5-7 10-7Zm0 2C8.8 7 6 9.1 4.3 12 6 14.9 8.8 17 12 17s6-2.1 7.7-5C18 9.1 15.2 7 12 7Zm0 2.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z" />
                </svg>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Đổi mật khẩu</button>
        @if (!Model.IsRequiredBySystem)
        {
            <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Hủy</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
