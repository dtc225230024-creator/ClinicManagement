@model ClinicManagement.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="login-wrap">
    <form asp-action="Login" method="post" class="login-panel">
        <p class="eyebrow">ClinicCare AI</p>
        <h1>Đăng nhập hệ thống</h1>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label asp-for="Username" class="form-label">Tên đăng nhập</label>
        <input asp-for="Username" class="form-control" autocomplete="username" />
        <span asp-validation-for="Username" class="text-danger"></span>

        <label asp-for="Password" class="form-label mt-3">Mật khẩu</label>
        <div class="password-field">
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" data-password-toggle-target="true" />
            <button class="password-toggle" type="button" data-password-toggle="true" aria-label="Hiện mật khẩu" aria-pressed="false">
                <svg class="password-toggle-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                    <path d="M12 5c5 0 8.7 4.1 10 7-1.3 2.9-5 7-10 7s-8.7-4.1-10-7c1.3-2.9 5-7 10-7Zm0 2C8.8 7 6 9.1 4.3 12 6 14.9 8.8 17 12 17s6-2.1 7.7-5C18 9.1 15.2 7 12 7Zm0 2.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z" />
                </svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>

        <button class="btn btn-primary w-100 mt-4" type="submit">Đăng nhập</button>
        <div class="demo-accounts">
            <strong>Tài khoản demo</strong>
            <span>admin, letan, bacsi</span>
            <span>Mật khẩu mặc định: Clinic@2026!</span>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
