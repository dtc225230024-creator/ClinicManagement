@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi.</h1>
<h2 class="text-danger">Hệ thống không thể xử lý yêu cầu hiện tại.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>
    Vui lòng quay lại trang trước hoặc thử lại sau. Nếu lỗi tiếp tục xảy ra, hãy ghi lại mã yêu cầu để kiểm tra.
</p>
