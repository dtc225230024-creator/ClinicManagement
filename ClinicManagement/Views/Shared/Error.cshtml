@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi.</h1>
<h2 class="text-danger">Hệ thống không thể xử lý yêu cầu hiện tại.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Chế độ phát triển</h3>
<p>
    Khi chạy ở môi trường <strong>Development</strong>, hệ thống sẽ hiển thị thông tin lỗi chi tiết hơn.
</p>
<p>
    <strong>Không nên bật môi trường Development cho bản triển khai chính thức.</strong>
    Việc này có thể làm lộ thông tin nhạy cảm từ lỗi hệ thống cho người dùng cuối.
    Khi cần debug cục bộ, đặt biến môi trường <strong>ASPNETCORE_ENVIRONMENT</strong> là <strong>Development</strong>
    rồi khởi động lại ứng dụng.
</p>
