@model ClinicManagement.Models.AiSymptomRule
@{
    ViewData["Title"] = Model.AiSymptomRuleId == 0 ? "Thêm luật AI" : "Cập nhật luật AI";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Gợi ý chuyên khoa</p>
        <h1>@ViewData["Title"]</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-action="AiRules">Quay lại</a>
</section>

<form asp-action="EditAiRule" method="post" class="form-grid">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="AiSymptomRuleId" type="hidden" />

    <label class="form-label">
        Chuyên khoa
        <select asp-for="DepartmentId" class="form-select">
            @foreach (var department in ViewBag.Departments)
            {
                <option value="@department.DepartmentId">@department.DepartmentName</option>
            }
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </label>

    <label class="form-label">
        Cụm triệu chứng
        <input asp-for="Term" class="form-control" placeholder="Ví dụ: chướng bụng, đầy hơi" />
        <span asp-validation-for="Term" class="text-danger"></span>
    </label>

    <label class="form-label">
        Điểm ưu tiên
        <input asp-for="Score" class="form-control" type="number" min="1" max="100" />
        <span asp-validation-for="Score" class="text-danger"></span>
    </label>

    <label class="form-check">
        <input asp-for="IsActive" class="form-check-input" />
        Đang dùng để gợi ý
    </label>

    <div class="form-actions">
        <button class="btn btn-primary"
                type="submit"
                data-confirm-modal="true"
                data-confirm-title="Lưu luật AI?"
                data-confirm-message="Hệ thống sẽ cập nhật bộ gợi ý chuyên khoa sau khi lưu."
                data-confirm-text="Lưu"
                data-confirm-style="primary">Lưu</button>
        <a class="btn btn-outline-secondary" asp-action="AiRules">Hủy</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
