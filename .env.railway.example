# Railway web service variables.
# In Railway, prefer using variable references from the MySQL service.

ASPNETCORE_ENVIRONMENT=Production
TZ=Asia/Ho_Chi_Minh

# Railway provides PORT automatically for the web service.
# The app reads PORT and binds to http://0.0.0.0:$PORT.

MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQLUSER=${{MySQL.MYSQLUSER}}
MYSQLPASSWORD=${{MySQL.MYSQLPASSWORD}}
MYSQLDATABASE=${{MySQL.MYSQLDATABASE}}

# Alternative supported by the app:
# MYSQL_URL=${{MySQL.MYSQL_URL}}
